FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      p;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [1 -1 -2 0 0 0 0]; // Pa

internalField   uniform 101352.9;

boundaryField
{
    inlet
    {
        type            zeroGradient; // Subsonic inlet: prevents acoustic reflections
    }
    outlet
    {
        type            fixedValue;   // Enforces physical static backpressure
        value           uniform 101352.9;
    }
    top
    {
        type            fixedValue;
        value           uniform 101352.9;
    }
    upstreamWall
    {
        type            symmetryPlane;
    }
    plate
    {
        type            zeroGradient;
    }
    frontAndBack
    {
        type            empty;
    }
}
