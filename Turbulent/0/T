FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      T;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 1 0 0 0]; // K

internalField   uniform 294.44;

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform 294.44;
    }
    outlet
    {
        type            zeroGradient;
    }
    top
    {
        type            inletOutlet;
        inletValue      uniform 294.44;
        value           uniform 294.44;
    }
    upstreamWall
    {
        type            symmetryPlane;
    }
    plate
    {
        type            zeroGradient; // Adiabatic wall
    }
    frontAndBack
    {
        type            empty;
    }
}
