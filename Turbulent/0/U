FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 -1 0 0 0 0]; // m/s

internalField   uniform (68.79 0 0);

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform (68.79 0 0);
    }
    outlet
    {
        type            zeroGradient;
    }
    top
    {
        type            inletOutlet;
        inletValue      uniform (68.79 0 0);
        value           uniform (68.79 0 0);
    }
    upstreamWall
    {
        type            symmetryPlane;
    }
    plate
    {
        type            noSlip;
    }
    frontAndBack
    {
        type            empty;
    }
}
