FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      T;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 1 0 0 0];

internalField   uniform 388.89;

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform 388.89;
    }

    outlet
    {
        type            zeroGradient;
    }

    plate
    {
        type            zeroGradient; // adiabatic wall condition
    }

    farfield
    {
        type            fixedValue;
        value		uniform 388.89;
    }

    upstreamSlip
    {
        type            symmetry;
    }

    frontAndBack
    {
        type            empty;
    }
}

