FoamFile
{
    version     2.0;
    format      ascii;
    arch        "LSB;label=32;scalar=64";
    class       volScalarField;
    location    "0";
    object      rho;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [1 -3 0 0 0 0 0];

internalField   uniform 0.370517;

boundaryField
{
    inlet
    {
        type            calculated;
        value           uniform 0.370517;
    }
    outlet
    {
        type            calculated;
        value           uniform 0.370517;
    }
    plate
    {
        type            calculated;
        value           uniform 0.370517;
    }
    farfield
    {
        type            calculated;
        value           uniform 0.370517;
    }
    upstreamSlip
    {
        type            symmetry;
    }
    frontAndBack
    {
        type            empty;
    }
}


