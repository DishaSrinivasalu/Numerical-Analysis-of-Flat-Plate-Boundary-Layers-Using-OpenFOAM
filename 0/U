FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (39.53 0 0);

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform (39.53 0 0);
    }

    outlet
    {
        type            zeroGradient;
    }

    farfield
    {
        type            fixedValue;
        value           uniform (39.53 0 0);
    }

    plate
    {
        type            noSlip; // Enforces U = 0 at the wall to create the boundary layer
    }

    upstreamSlip
    {
        type            symmetry;
    }

    frontAndBack
    {
        type            empty;
    }
}
