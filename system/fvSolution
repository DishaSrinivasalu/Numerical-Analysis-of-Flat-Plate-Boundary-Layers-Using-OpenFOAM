FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    "p|pFinal"
    {
        solver          GAMG;
        tolerance       1e-6;
        relTol          0.01;
        smoother        GaussSeidel;
    }

    "U|UFinal|h|hFinal|e|eFinal|K|KFinal"
    {
        solver          PBiCGStab;
        preconditioner  DILU;
        tolerance       1e-7;
        relTol          0.1;
    }

    "rho|rhoFinal"
    {   
	solver		PCG;
	preconditioner  DIC;
	tolerance       1e-6;
	relTol          0.1;
    }
}

PIMPLE
{
    nOuterCorrectors 2; // Allows pressure-velocity coupling adjustment per time-step
    nCorrectors      2;
    nNonOrthogonalCorrectors 0;
    momentumPredictor yes;
}

